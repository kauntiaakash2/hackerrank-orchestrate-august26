# Optional. The deterministic local pipeline does not require API credentials.
ROUTER_SEED=2026
ROUTER_LOG_LEVEL=INFO
ROUTER_MEDIA_CACHE=cache/media_extractions.json
ROUTER_OCR_LANGUAGES=eng
ROUTER_OCR_TIMEOUT=20
# Optional explicit path when `tesseract` is not on PATH.
TESSERACT_CMD=
# Requires the optional `faster-whisper` package and a locally available model.
ROUTER_WHISPER_MODEL=small
ROUTER_WHISPER_DEVICE=cpu
ROUTER_WHISPER_COMPUTE_TYPE=int8
ROUTER_ASR_TIMEOUT=120
